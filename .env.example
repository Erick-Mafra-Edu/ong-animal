# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_EMAIL_VERIFICATION_ENABLED=false
NEXT_PUBLIC_AUTH_DEBUG_LOGS=false
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Chat adapter: 'supabase' (default, uses Supabase Realtime) or 'socketio'
NEXT_PUBLIC_CHAT_ADAPTER=supabase

# Socket.IO server URL (required when NEXT_PUBLIC_CHAT_ADAPTER=socketio)
NEXT_PUBLIC_SOCKET_IO_URL=

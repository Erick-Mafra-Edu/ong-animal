# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Chat adapter: 'supabase' (default) or 'socketio'
EXPO_PUBLIC_CHAT_ADAPTER=supabase

# Socket.IO server URL (required when EXPO_PUBLIC_CHAT_ADAPTER=socketio)
EXPO_PUBLIC_SOCKET_IO_URL=http://localhost:3001
